---
import Base from '../layouts/Base.astro';
---
<Base title="Cookie notice | PTPN">
  <section style="padding-block:96px 72px"><div class="wrap" style="max-width:820px">
    <span class="eyebrow">Legal</span>
    <h1 style="margin-top:18px;font-size:clamp(30px,4vw,46px)">Cookie notice</h1>
    <div class="legal"><h2>Essential only</h2>
<p>This site stores the minimum needed to keep you signed in to the member app. There are no advertising, analytics or social media cookies, and nothing is placed by third parties for tracking.</p>
<p>Because there is nothing optional, there is no cookie banner: everything on the site works the same for everyone.</p>
<p style="margin-top:26px">Last updated: 28 October 2026.</p></div>
  </div></section>
</Base>
<style>
  .legal{margin-top:30px;color:var(--muted);font-size:16px;line-height:1.75}
  .legal h2{font-size:19px;color:var(--ink);margin:34px 0 10px;letter-spacing:0}
  .legal p,.legal li{margin-bottom:12px}
  .legal ul{padding-left:20px;display:grid;gap:6px}
</style>
