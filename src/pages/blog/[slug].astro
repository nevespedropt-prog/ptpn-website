---
import Base from '../../layouts/Base.astro';
import { posts, sortedPosts, categories } from '../../data/posts';
import { site } from '../../data/site';
export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const cat = categories[post.category];
const related = sortedPosts.filter((p) => p.slug !== post.slug).sort((a, b) => Number(b.category === post.category) - Number(a.category === post.category)).slice(0, 2);
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const url = `${site.url}/blog/${post.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.summary,
    datePublished: post.date,
    dateModified: post.date,
    mainEntityOfPage: url,
    articleSection: cat.label,
    author: { '@type': 'Person', name: 'Pedro', url: site.url },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: site.url + '/blog/' },
      { '@type': 'ListItem', position: 3, name: post.title, item: url },
    ],
  },
];
---
<Base title={`${post.title} | PTPN Blog`} description={post.summary} schema={schema}>
  <article style="padding-block:96px 72px"><div class="wrap" style="max-width:760px">
    <a class="back" href="../">Blog</a>
    <p class="cat"><a href={`../category/${post.category}/`}>{cat.label}</a></p>
    <h1 style="margin-top:14px;font-size:clamp(32px,4.4vw,52px)">{post.title}</h1>
    <p class="fine" style="margin-top:14px">By Pedro · {fmt(post.date)} · {post.minutes} min read</p>
    <div class="post">
      {post.body.map((b) => b.startsWith('## ') ? <h2>{b.slice(3)}</h2> : <p>{b}</p>)}
    </div>
    <div class="post-cta">
      <h2>Book a free consultation</h2>
      <p>No charge, no obligation. Tell me what you want to change and I will tell you honestly whether I can help.</p>
      <a class="btn" href="../../#contact">Book a free consultation</a>
    </div>
    <div class="more">
      <h2>More from the blog</h2>
      <div class="more__grid">
        {related.map((p) => (
          <a href={`../${p.slug}/`}><span>{categories[p.category].label}</span><b>{p.title}</b></a>
        ))}
      </div>
    </div>
  </div></article>
</Base>
<style>
  .back{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);display:inline-block;padding:10px 0}
  .cat{margin-top:22px;font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase}
  .cat a{color:var(--muted)}
  .cat a:hover{color:var(--gold-light)}
  .post{margin-top:36px;color:var(--ink-2,#cfcbc2);font-size:17.5px;line-height:1.75}
  .post p{margin:0 0 20px}
  .post h2{font-size:24px;margin:40px 0 14px;letter-spacing:-.015em;color:var(--ink)}
  .post-cta{margin-top:56px;border:1px solid var(--line);border-left:2px solid var(--gold);background:var(--card);padding:34px 32px}
  .post-cta h2{font-size:24px}
  .post-cta p{color:var(--muted);margin:12px 0 22px;line-height:1.65}
  .more{margin-top:64px}
  .more h2{font-size:22px;margin-bottom:18px}
  .more__grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .more__grid a{display:flex;flex-direction:column;gap:8px;border:1px solid var(--line);border-left:2px solid var(--gold);background:var(--card);padding:22px 20px}
  .more__grid a:hover{border-color:var(--gold-deep)}
  .more__grid span{font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold)}
  .more__grid b{font-family:var(--display);font-size:17px;line-height:1.3}
  @media (max-width:760px){.more__grid{grid-template-columns:1fr}.post-cta,.more{text-align:center}.cat{text-align:center}.back{display:block;text-align:center}article h1,article .fine{text-align:center}}
</style>
