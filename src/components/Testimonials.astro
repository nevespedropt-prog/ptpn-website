---
import { testimonials } from '../data/site';
const lead = testimonials.find((t) => t.lead)!;
const rest = testimonials.filter((t) => !t.lead);
---

<section class="tst">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Clients</span>
      <h2>What clients say.</h2>
    </div>

    <figure class="tst__lead">
      <blockquote>“{lead.quote}”</blockquote>
      {lead.context && <p class="tst__context">{lead.context}</p>}
      <figcaption>
        <strong>{lead.name}</strong>
        <span>{lead.meta}</span>
      </figcaption>
    </figure>

    <div class="tst__grid">
      {rest.map((t) => (
        <figure class="tst__card">
          <blockquote>“{t.quote}”</blockquote>
          {t.context && <p class="tst__context">{t.context}</p>}
          <figcaption>
            <strong>{t.name}</strong>
            <span>{t.meta}{t.edited ? ' · lightly edited' : ''}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="fine tst__note">
      Reviews are reproduced from Google and from client feedback. Quotes marked lightly edited were
      tidied for spelling and grammar only; the meaning is unchanged.
    </p>
  </div>
</section>

<style>
  .tst__lead {
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 2px solid var(--gold);
    border-radius: var(--radius);
    padding: 52px 56px;
    margin: 0;
  }

  .tst__lead blockquote {
    font-family: var(--display);
    font-size: clamp(22px, 3vw, 36px);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -.02em;
    margin: 0;
  }

  .tst__context {
    margin-top: 20px;
    color: var(--muted);
    font-size: 17px;
    max-width: 60ch;
  }

  .tst__lead figcaption,
  .tst__card figcaption {
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: baseline;
  }

  .tst__lead figcaption strong,
  .tst__card figcaption strong {
    font-family: var(--display);
    font-size: 15px;
    font-weight: 700;
    color: var(--gold-light);
  }

  .tst__lead figcaption span,
  .tst__card figcaption span {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .06em;
    color: var(--muted);
  }

  .tst__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .tst__card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 34px 32px;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .tst__card blockquote {
    font-size: 17.5px;
    line-height: 1.55;
    color: #cdc8bf;
    margin: 0;
    flex: 1;
  }

  .tst__card figcaption { margin-top: 22px; }

  .tst__note { margin-top: 26px; max-width: 70ch; }

  @media (max-width: 760px) {
    .tst__grid { grid-template-columns: 1fr; }
    .tst__lead { padding: 34px 26px; }
  }
</style>
