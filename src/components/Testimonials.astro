---
import { testimonials } from '../data/site';
const lead = testimonials.find((t) => t.lead)!;
const rest = testimonials.filter((t) => !t.lead);
---

<section class="tst">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Clients</span>
      <h2>What clients say.</h2>
    </div>

    <figure class="tst__lead">
      <blockquote>“{lead.quote}”</blockquote>
      {lead.context && <p class="tst__context">{lead.context}</p>}
      {lead.stars && <span class="tst__stars" role="img" aria-label={`${lead.stars} out of 5 stars`}>{Array.from({ length: lead.stars }).map(() => (<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z" fill="currentColor"/></svg>))}</span>}
      <figcaption>
        <strong>{lead.name}</strong>
        <span>{lead.meta}</span>
      </figcaption>
    </figure>

    <div class="tst__grid">
      {rest.map((t) => (
        <figure class="tst__card">
          <blockquote>“{t.quote}”</blockquote>
          {t.context && <p class="tst__context">{t.context}</p>}
          {t.stars && <span class="tst__stars" role="img" aria-label={`${t.stars} out of 5 stars`}>{Array.from({ length: t.stars }).map(() => (<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z" fill="currentColor"/></svg>))}</span>}
          <figcaption>
            <strong>{t.name}</strong>
            <span>{t.meta}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="fine tst__note">Client reviews, some shortened for length.</p>
  </div>
</section>

<style>
  .tst__stars { display: flex; justify-content: center; gap: 3px; color: var(--gold); margin-top: 20px; }
  .tst__stars svg { display: block; }

  .tst__lead {
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 2px solid var(--gold);
    border-radius: var(--radius);
    padding: 52px 56px;
    margin: 0;
    text-align: center;
  }

  .tst__lead blockquote {
    font-family: var(--display);
    font-size: clamp(22px, 3vw, 36px);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -.02em;
    margin: 0;
  }

  .tst__context {
    margin-top: 20px;
    color: var(--muted);
    font-size: 17px;
    max-width: 60ch;
    margin-inline: auto;
  }

  .tst__lead figcaption,
  .tst__card figcaption {
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    text-align: center;
  }

  .tst__lead figcaption strong,
  .tst__card figcaption strong {
    font-family: var(--display);
    font-size: 15px;
    font-weight: 700;
    color: var(--gold-light);
  }

  .tst__lead figcaption span,
  .tst__card figcaption span {
    font-family: var(--mono);
    font-size:12px;
    letter-spacing: .06em;
    color: var(--muted);
  }

  .tst__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .tst__card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 34px 32px;
    margin: 0;
    display: flex;
    flex-direction: column;
    text-align: center;
    border-left: 2px solid var(--gold);
  }

  .tst__card blockquote {
    font-size: 17.5px;
    line-height: 1.55;
    color: #cdc8bf;
    margin: 0;
    flex: 1;
  }

  .tst__card figcaption { margin-top: 22px; }

  .tst__note { margin: 26px auto 0; max-width: 70ch; text-align: center; }

  @media (max-width: 760px) {
    .tst__grid { grid-template-columns: 1fr; }
    .tst__lead { padding: 34px 26px; }
    .tst__card { text-align: center; }
    .tst__stars { justify-content: center; }
    .tst__note { text-align: center; }
  }
</style>
