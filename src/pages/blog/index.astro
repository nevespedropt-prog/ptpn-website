---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/posts';
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog | PTPN" description="Straight answers on training, fat loss and getting started again, from Pedro, a personal trainer in Enfield.">
  <section style="padding-block:96px 40px"><div class="wrap">
    <span class="eyebrow">Journal</span>
    <h1 style="margin-top:18px;font-size:clamp(34px,4.6vw,56px)">Training and nutrition, explained.</h1>
    <p class="lede" style="margin-top:18px">Straight answers, written between sessions. Each one covers something clients have actually asked.</p>
  </div></section>
  <section style="padding-block:0 110px"><div class="wrap">
    <div class="blog-grid">
      {posts.map((p) => (
        <article>
          <h2><a href={`./${p.slug}/`}>{p.title}</a></h2>
          <p>{p.summary}</p>
          <span class="mono">{fmt(p.date)} · {p.minutes} min read</span>
        </article>
      ))}
    </div>
  </div></section>
</Base>
<style>
  .blog-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .blog-grid article{border:1px solid var(--line);background:var(--card);padding:34px 30px;display:flex;flex-direction:column;gap:12px;position:relative}
  .blog-grid h2{font-size:22px;letter-spacing:-.015em}
  .blog-grid h2 a::after{content:"";position:absolute;inset:0}
  .blog-grid p{color:var(--muted);font-size:15.5px;line-height:1.65;flex:1}
  .blog-grid .mono{color:var(--faint);font-size:12px}
  .blog-grid article:hover{border-color:var(--gold-deep)}
  @media (max-width:760px){.blog-grid{grid-template-columns:1fr}}
</style>
